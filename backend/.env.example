# Gemini API key — enables dynamic *-flash-lite model discovery (latest first)
# and the oversimplification expand aid.
GEMINI_API_KEY=
# Optional: pin a specific model as the first Gemini tier (otherwise fully dynamic)
GEMINI_MODEL=

# Groq permanent fallback tier
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Boot requires at least one of GEMINI_API_KEY / GROQ_API_KEY
PORT=3001

# Rate limits
# Generate/edit requests allowed per IP per minute (0 disables). Default 5.
RATE_LIMIT_PER_MIN=5
# Shared Gemini RPM budget across all flash-lite tiers (skip Gemini → Groq when empty). Default 8.
GEMINI_RPM=8
# Max concurrent LLM calls (0 disables the semaphore). Default 2.
MAX_CONCURRENT_LLM=2
# Optional UTC-day cap across generate+edit (0 = unlimited).
DAILY_REQUEST_BUDGET=0
